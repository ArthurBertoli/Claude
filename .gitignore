# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment variables / secrets
.env
.env.*
!.env.example

# FastAPI / Uvicorn
*.log

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# Type checking / linting caches
.mypy_cache/
.ruff_cache/
.dmypy.json

# Databases (common local dev files)
*.sqlite3
*.db

# IDEs / editors
.vscode/
.idea/
*.swp

# OS files
.DS_Store
Thumbs.db

# Alembic (if used for migrations) - keep versions, ignore local overrides
# alembic.ini local overrides can be added here if needed
